{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Osteo Manager",
  "version": "0.4.1",
  "identifier": "fr.osteomanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Osteo Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; frame-src blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Business",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFMEExM0ZFNDk3QUJCNTkKUldSWnUzcEovaE1LcmxPdTU1SGlKRWUyYWN2c3hlY2FQMDlvYzMraE5aTVhHY1d1TER2WjZ6NTQK",
      "endpoints": [
        "https://github.com/timothee-faget/osteo-manager-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
